# Plantilla de variables de entorno del sistema
# Copia este archivo como .env y ajusta los valores segun tu entorno:

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root

# ESB y Puertos
ESB_PORT=8280
ESB_URL=http://localhost:8280
CLIENTES_PORT=8081
INVENTARIOS_PORT=8082
PEDIDOS_PORT=8083
FACTURACION_PORT=8084
NOTIFICACIONES_PORT=8085

# Notificaciones
SMTP_HABILITADO=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

